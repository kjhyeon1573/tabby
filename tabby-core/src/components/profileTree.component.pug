.p-2.h-100.d-flex.flex-column
    input.form-control.form-control-sm.mb-1(
        type='text',
        [(ngModel)]='filter',
        [placeholder]='"Filter or enter an address"|translate',
        (ngModelChange)='onFilterChange()',
        (keydown.enter)='onFilterEnter()'
    )

    .profile-tree.h-100
        .d-flex.flex-column.p-2.profile-tree-container

            ng-container(*ngFor='let group of rootGroups')
                ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: group, depth: 0}')

            ng-template(#recursiveGroup let-group let-depth='depth')
                a.tree-item(
                    (click)='toggleGroupCollapse(group)',
                    [class.attention]='groupHasAttention(group)',
                    [style.paddingLeft.px]='depth * 20',
                    (contextmenu)='groupContextMenu(group, $event)',
                    href='#'
                )
                    .fw-20
                        .fa.fa-fw.fas.fa-chevron-right.ms-1.text-muted(*ngIf='group.collapsed')
                        .fa.fa-fw.fas.fa-chevron-down.ms-1.text-muted(*ngIf='!group.collapsed')
                    .fw-20([class.attention]='groupHasAttention(group)', [class.working]='groupIsWorking(group)')
                        profile-icon.ms-1([icon]='group.icon ?? "far fa-folder"', [color]='group?.color')
                    span.ms-2.me-auto {{ group.name || ("Ungrouped"|translate) }}

                ng-container(*ngIf='!group.collapsed')
                    ng-container(*ngFor='let profile of group.profiles')
                        a.tree-item.profile-item(
                            (dblclick)='launchProfile(profile)',
                            [style.paddingLeft.px]='(depth + 1) * 20',
                            (contextmenu)='profileContextMenu(profile, $event)',
                            (mouseenter)='onProfileRowEnter($event)',
                            (mouseleave)='onProfileRowLeave($event)',
                            [class.attention]='attentionProfiles[profile.id]',
                            [class.active]='isActiveProfile(profile)',
                            href='#'
                        )
                            .fw-20(
                                [class.attention]='attentionProfiles[profile.id]',
                                [class.working]='workingProfiles[profile.id] && !attentionProfiles[profile.id]'
                            )
                                profile-icon.ms-1(
                                    [icon]='profile.icon',
                                    [color]='profileStatus[profile.id]?.active ? activeProfileColor : profile.color',
                                    [attr.title]='profileStatus[profile.id]?.description'
                                )
                            .profile-label.ms-2
                                span.no-wrap.profile-name {{ profile.name }}
                                span.profile-detail(
                                    *ngIf='detailParts(profile.id) as parts',
                                    [attr.title]='profileStatus[profile.id]?.detail'
                                )
                                    span.detail-track
                                        span.detail-prefix {{ parts[0] }}
                                        span.detail-base {{ parts[1] }}
                                        span.detail-suffix {{ parts[2] }}

                            .actions
                                .action(
                                    *ngIf='isStateful(profile)',
                                    (click)='launchProfile(profile, true)',
                                    [title]='"Open in tab bar"|translate'
                                )
                                    .fa.fa-fw.far.fa-window-maximize
                                .action(
                                    *ngIf='!isStateful(profile) && hasOpenTab(profile)',
                                    (click)='closeProfileTab(profile)',
                                    [title]='"Close tab"|translate'
                                )
                                    .fa.fa-fw.fas.fa-times
                                .action((click)='launchProfile(profile)')
                                    .fa.fa-fw.fas.fa-play

                    ng-container(*ngFor='let child of group.children')
                        ng-container(*ngTemplateOutlet='recursiveGroup; context: {$implicit: child, depth: depth + 1}')

            ng-container(*ngIf='quickConnectOptions.length')
                a.tree-item.quick-connect-header(href='#')
                    .fw-20
                    .fw-20
                        profile-icon.ms-1(icon='fas fa-bolt')
                    span.ms-2.me-auto {{ 'Quick connect'|translate }}

                a.tree-item.profile-item.quick-connect-item(
                    *ngFor='let option of quickConnectOptions',
                    (dblclick)='launchQuickConnect(option)',
                    [style.paddingLeft.px]='20',
                    href='#'
                )
                    .fw-20
                        profile-icon.ms-1([icon]='option.icon')
                    .profile-label.ms-2
                        span.no-wrap.profile-name {{ option.profile.name }}
                        span.profile-detail
                            span.detail-track
                                span.detail-base {{ option.provider.name|translate }}

                    .actions
                        .action((click)='saveQuickConnect(option)', [title]='"Save as profile"|translate')
                            .fa.fa-fw.fas.fa-plus
                        .action((click)='launchQuickConnect(option)', [title]='"Quick connect"|translate')
                            .fa.fa-fw.fas.fa-play
.grabber(
    (mousedown)="startResize($event)"
)
